<?xml version="1.0" encoding="utf-8"?>
<!--
    The one colour Android needs to know about before Flutter is running.

    `main.dart` builds its theme with `Brightness.dark` and no light variant, so
    the app is dark whatever the phone's setting says. The launch window has to
    match, or every cold start is a white flash followed by a dark app — which
    reads as a bug on a phone in a dark room.
-->
<resources>
    <color name="launch_background">#12100E</color>
	<color name="ic_launcher_background">#12100E</color>
</resources>