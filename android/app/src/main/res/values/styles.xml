<?xml version="1.0" encoding="utf-8"?>
<!--
    Light, now that the app has a light theme.

    These followed the system setting, then were forced dark while the app was
    dark-only, and now follow it again — which is the right answer for anyone
    who has not overridden the choice in Settings. See ../values/colors.xml for
    the case this cannot get right.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        No icon on it.

        Android 12 and later draw the launcher icon in a small circle over this
        background, at a fixed size with no room for anything else — Scout ends
        up as a thumbnail. `windowSplashScreenAnimatedIcon` set to nothing
        leaves a plain coloured screen, which the app's own splash then takes
        over from without a visible seam. See lib/ui/splash.dart.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@null</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
