rules_version = '2';

/*
  Nothing reaches this database from a browser. Ever.

  Registration goes through the `register` function, which runs with admin
  credentials and drops every field it was not expecting. If clients could
  write here directly they could store whatever they liked under whatever key
  they liked, and the promise on the settings card — a delivery address and a
  list of times, nothing else — would be enforced by the app's good manners
  rather than by anything.

  Denying reads matters just as much: a push endpoint is the one identifier in
  this system, and a rule that let anyone read the collection would hand over
  every subscriber's.
*/
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
