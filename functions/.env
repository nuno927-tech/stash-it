# Which websites are allowed to talk to the reminder sender.
#
# Firebase reads this file automatically when you deploy. There is no place
# for it in firebase.json — that file describes what to deploy, not what the
# deployed code is configured with.
#
# Anything not on this list is refused. Comma separated, no trailing slashes,
# no spaces. Add stash-it.app here the day it exists.
#
# THIS FILE IS COMMITTED ON PURPOSE. It holds no secrets — a list of allowed
# websites is public information, and keeping it in the repository is what
# makes a deploy from a fresh clone behave the same as one from this laptop.
#
# NOTHING SECRET GOES IN HERE. The VAPID private key lives in Firebase's own
# secret store, set once with `firebase functions:secrets:set`, and never in a
# file. test/push.test.ts fails the build if any other name appears below.

ALLOWED_ORIGINS=https://nuno927-tech.github.io
