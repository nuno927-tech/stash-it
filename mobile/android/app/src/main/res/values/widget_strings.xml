<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- What the launcher's widget picker shows. Named for what it does on the
         home screen rather than for the app, because the picker already groups
         by app and repeating the name wastes the only line there is. -->
    <string name="widget_quick_add_label">Stash something</string>
    <string name="widget_quick_add_description">Three ways in: an item, a document, a subscription.</string>
    <!--
        The masthead is a picture now — rendered by the app so all three widgets
        show the identical thing — so this is what a screen reader is given in
        its place. Without it the widget announces itself as "image".

        The two halves that used to be set as text are gone. They were the
        drift: two TextViews in the app's font against the same words drawn in
        Flutter for the ring, kept in step by hand and not staying in step.
    -->
    <string name="widget_wordmark">Stash it</string>
    <string name="widget_scout">Scout</string>
    <string name="widget_add_item">An item</string>
    <string name="widget_add_paper">A document</string>
    <string name="widget_add_sub">A subscription</string>

    <string name="widget_coming_up_label">Coming up</string>
    <string name="widget_coming_up_description">What runs out next. Resize for more rows.</string>

    <string name="widget_ring_label">Your cover</string>
    <string name="widget_ring_description">In date, needing action, lapsed.</string>

    <!-- The settings screen, shown when a Coming up widget is placed. -->
    <string name="widget_settings_title">Coming up</string>
    <string name="widget_settings_blurb">What this widget keeps an eye on. Drag it taller for more rows.</string>
    <string name="widget_settings_items">Items and their warranties</string>
    <string name="widget_settings_papers">Documents</string>
    <string name="widget_settings_subscriptions">Subscriptions</string>
    <string name="widget_settings_urgent">Only what needs attention</string>
    <string name="widget_settings_urgent_note">Hides anything with months left on it.</string>
    <string name="widget_settings_save">Save</string>

    <!-- Shown when the three boxes above are all unticked, which is a different
         emptiness from having nothing stashed. -->
    <string name="widget_nothing_chosen">Nothing chosen to show</string>
</resources>
