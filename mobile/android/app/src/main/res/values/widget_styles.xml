<?xml version="1.0" encoding="utf-8"?>
<!--
    The wordmark's type, and why it is a style rather than three attributes.

    The app draws "Stash it" in Bricolage Grotesque. Android can load a font
    from res/font/ — but only from API 26. Below that, `@font/` is not a thing
    the framework knows, and an unresolvable reference inside a widget layout
    does not fall back to a default: it throws while the LAUNCHER is inflating,
    which reaches the home screen as "An error occurred when loading widget".

    A style is the one place that can differ by API level without the layout
    knowing. This file is the floor — size, spacing and weight, in the system
    font — and values-v26 adds the typeface on the phones that have one.

    So on Android 8 and up the widget matches the app. Below that it is the
    same wordmark in the system font, which is a smaller thing to lose than
    the whole widget.

    ── On the weight ──────────────────────────────────────────────────────────

    The app asks for w800, and Bricolage's default variable instance IS w800 —
    so values-v26 needs no help. This fallback is the system font, which starts
    at regular, so it asks for bold here and values-v26 deliberately does not.
-->
<resources>
    <style name="WidgetWordmark">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.025</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!--
        One row of the Coming up list: a name on the left, a countdown on the
        right. The whole row is one tap target, so the padding is generous
        enough to hit with a thumb rather than tuned to look tight.
    -->
    <style name="WidgetRow">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
    </style>

    <style name="WidgetRowTitle">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!--
        The number, coloured by tone. The colour is set by the provider from
        @color/widget_moss, _honey or _ember — a hex string travelling in the
        payload would be a second copy of the palette, and the one nobody
        remembers to change.
    -->
    <style name="WidgetRowValue">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- "days", "months". A unit is not a number: same tone, smaller, and it
         follows the figure rather than competing with it. -->
    <style name="WidgetRowUnit">
        <item name="android:textSize">11sp</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:textColor">@color/widget_muted</item>
        <item name="android:maxLines">1</item>
    </style>

    <!--
        The settings screen is a dialog, not a page.

        It is four checkboxes reached by dropping a widget on a home screen, and
        a full-screen activity for that reads as leaving the launcher rather
        than answering a question about it.

        The light variant here and the dark one in values-night, because
        DeviceDefault does not follow the phone by itself.
    -->
    <style name="WidgetSettingsTheme"
        parent="@android:style/Theme.DeviceDefault.Light.Dialog.NoActionBar" />
</resources>
