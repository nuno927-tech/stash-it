<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 8 and up: the app's own typeface. See values/widget_styles.xml for
    why this split exists at all.

    No textStyle="bold" here, unlike the fallback. Bricolage is variable and its
    default instance is already weight 800 — the same w800 the app asks for — so
    asking Android to thicken it would be synthesising bold on top of extrabold.
    The fallback keeps it because the system font starts at regular.
-->
<resources>
    <style name="WidgetWordmark" parent="">
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">-0.025</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">@font/bricolage_grotesque</item>
    </style>
</resources>
