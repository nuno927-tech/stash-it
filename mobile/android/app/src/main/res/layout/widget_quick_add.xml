<?xml version="1.0" encoding="utf-8"?>
<!--
    Quick add: three ways into the app, and no data at all.

    The one widget with nothing to copy out of the encrypted database, which is
    why it is built first — it proves the whole pipeline (provider, manifest,
    tap routing, sizes) without any of the privacy weight the other two carry.

    RemoteViews rather than a rendered image, because there is nothing here to
    render: three labels and three tap targets, which is exactly what RemoteViews
    is good at. The two widgets that draw the app's own type and colour are the
    ones worth rendering in Flutter.

    ── Two rules this file broke, and the error they gave ──────────────────────

    "An error occurred when loading widget" is what a launcher says when it
    cannot inflate this layout. The launcher does that in ITS process, from an
    allowlist, and two things here were outside it:

      A bare <View>. Obvious as a divider, and not on the list — RemoteViews
      permits LinearLayout, FrameLayout, TextView, ImageView, Button,
      ProgressBar and a handful of others, and nothing else at all. The
      dividers below are ImageViews with a background, which is the same one
      pixel drawn by a class the launcher will accept.

      ?android:attr/selectableItemBackground. A theme attribute is a question,
      and the launcher's theme is the one being asked — not this app's. Tap
      feedback now comes from @drawable/widget_row, a resource of our own with
      no questions in it.

    The rule behind both: everything a widget layout names must be a concrete
    resource in this package. Anything resolved against a theme is resolved
    against somebody else's.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <!--
        The masthead: the wordmark, and Scout in the corner.

        Two TextViews rather than one with a coloured span, because the split is
        the whole point — "Stash" in the text colour, "it" in gold, exactly as
        lib/ui/parts.dart draws it. A span would put the same fact in Kotlin,
        where the app cannot see it.

        The gold half carries the weight, so it eats the empty middle and pushes
        Scout to the right edge without a spacer view. (Space is not on the
        RemoteViews allowlist; see tool/check_widget_layouts.py.)
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="2dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/quick_add_stash"
            style="@style/WidgetWordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_wordmark_stash"
            android:textColor="@color/widget_text" />

        <TextView
            android:id="@+id/quick_add_it"
            style="@style/WidgetWordmark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_wordmark_it"
            android:textColor="@color/widget_gold" />

        <!--
            Scout, sized in dp from a nodpi source so he is the same size on
            every screen. 32x34 keeps his 300x320 proportions; at this size he
            reads as a mark rather than a picture, which is what a corner wants.
        -->
        <ImageView
            android:id="@+id/quick_add_scout"
            android:layout_width="32dp"
            android:layout_height="34dp"
            android:src="@drawable/widget_scout"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:contentDescription="@string/widget_scout" />
    </LinearLayout>

    <!--
        Weighted rather than fixed, so the same three rows fill a 4x1 and a 4x2
        without a second layout. A widget somebody stretched should use the
        space it was given.
    -->
    <LinearLayout
        android:id="@+id/quick_add_item"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_row"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/widget_glyph_item"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/widget_add_item"
            android:textColor="@color/widget_text"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_line"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/quick_add_paper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_row"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/widget_glyph_paper"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/widget_add_paper"
            android:textColor="@color/widget_text"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_line"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/quick_add_sub"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_row"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/widget_glyph_sub"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/widget_add_sub"
            android:textColor="@color/widget_text"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
