<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and up.

    `allowBackup="false"` in the manifest covers cloud backup on older
    releases; this covers both cloud backup and device-to-device transfer on
    12+, which the old flag does not.

    Everything is excluded, deliberately. The database is encrypted with a key
    held in this device's Keystore, and the Keystore does not travel — so a
    copy of the file anywhere else is a file nobody can ever open. Better for
    the new phone to start empty and ask for a .stashit than to arrive holding
    an unreadable database and no way to say why.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
