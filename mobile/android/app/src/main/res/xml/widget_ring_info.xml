<?xml version="1.0" encoding="utf-8"?>
<!--
    Four cells by three, and it should keep roughly that shape.

    The face is the dashboard's card — wordmark, dial, Scout beside it, four
    figures underneath — and that composition does not survive being dragged
    into a square: fitCenter keeps the picture undistorted, so a square cell
    would show the same card with a band of nothing above and below it.

    The resize range below is generous in width and tight in height, which is
    the direction that degrades gracefully. Wider just means more margin.

    No previewLayout: the layout is an empty ImageView until the app has run
    once, so a live preview would show the picker a blank rounded rectangle.
    previewImage points at the app icon, which at least says whose widget it is.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="160dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="130dp"
    android:maxResizeWidth="400dp"
    android:maxResizeHeight="260dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/widget_ring"
    android:previewImage="@mipmap/ic_launcher"
    android:description="@string/widget_ring_description"
    android:updatePeriodMillis="0" />
